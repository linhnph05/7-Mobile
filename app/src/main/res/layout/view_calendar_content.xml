<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_md"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvMonthYear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/calendar_month_year_placeholder"
            android:textColor="@color/theme_text_primary"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_inactive"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/calendar_today"
            android:textColor="@color/theme_text_secondary"
            android:textSize="@dimen/text_xs"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnPrevMonth"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/theme_text_secondary" />

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/glCalendar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            app:columnCount="7">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:text="S" android:gravity="center" android:textColor="@color/theme_text_secondary" android:textSize="11sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:text="M" android:gravity="center" android:textColor="@color/theme_text_secondary" android:textSize="11sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:text="T" android:gravity="center" android:textColor="@color/theme_text_secondary" android:textSize="11sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:text="W" android:gravity="center" android:textColor="@color/theme_text_secondary" android:textSize="11sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:text="T" android:gravity="center" android:textColor="@color/theme_text_secondary" android:textSize="11sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:text="F" android:gravity="center" android:textColor="@color/theme_text_secondary" android:textSize="11sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:text="S" android:gravity="center" android:textColor="@color/theme_text_secondary" android:textSize="11sp" />
        </androidx.gridlayout.widget.GridLayout>

        <ImageView
            android:id="@+id/btnNextMonth"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/theme_text_secondary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/calendar_tasks_in_selected_date"
        android:textColor="@color/theme_text_secondary"
        android:textSize="@dimen/text_xs"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/spacing_sm"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_lg" />

    <LinearLayout
        android:id="@+id/layoutEmptyStateCalendar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/avatar_lg"
            android:layout_height="@dimen/avatar_lg"
            android:layout_marginBottom="@dimen/spacing_md"
            android:src="@drawable/ic_summary"
            app:tint="@color/theme_text_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overview_no_tasks"
            android:textColor="@color/theme_text_primary"
            android:textSize="@dimen/text_md"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:text="@string/overview_no_tasks_desc"
            android:textColor="@color/theme_text_secondary"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

</LinearLayout>
