<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/theme_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tvTrashTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task"
        android:textColor="@color/theme_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnRestoreTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chip_neutral"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="Khôi phục"
        android:textColor="@color/green_500"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnDeleteForever"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/bg_red_50"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="Xóa vĩnh viễn"
        android:textColor="@color/text_red_600"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnCloseTrashActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_neutral"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="Hủy"
        android:textColor="@color/slate_600"
        android:textSize="14sp" />

</LinearLayout>
