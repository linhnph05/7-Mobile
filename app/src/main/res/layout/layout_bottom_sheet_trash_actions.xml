<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/theme_surface"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tvTrashTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task"
        android:textColor="@color/theme_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDeleteForever"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_action_button_danger"
        android:gravity="center"
        android:minHeight="44dp"
        android:text="Xóa vĩnh viễn"
        android:textColor="@color/text_red_600"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnCloseTrashActions"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_action_button_neutral"
        android:gravity="center"
        android:minHeight="44dp"
        android:text="Hủy"
        android:textColor="@color/theme_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
