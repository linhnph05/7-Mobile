<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:orientation="vertical">

    <!-- TOP APP BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/imgUserAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/bg_avatar_bordered"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/theme_text_primary"
            app:layout_constraintStart_toEndOf="@id/imgUserAvatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/layoutRightIcons"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvProjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Project Name"
                android:textColor="@color/theme_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="October 2023"
                android:textColor="@color/theme_text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRightIcons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnMoreOptions"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Options"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/theme_text_secondary" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- VIEW TOGGLE (Timeline/Board/Calendar | filter | AI) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Timeline (active in this view) -->
        <TextView
            android:id="@+id/tabTimeline"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_tab_active"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="Timeline"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Board -->
        <TextView
            android:id="@+id/tabBoard"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="Board"
            android:textColor="@color/theme_text_secondary"
            android:textSize="13sp" />

        <!-- Calendar -->
        <TextView
            android:id="@+id/tabCalendar"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tab_inactive"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="Calendar"
            android:textColor="@color/theme_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ══════════════════════════════════
         GANTT GRID 
         ══════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Outer Vertical ScrollView for scrolling tasks down -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- CỘT TRÁI: -->
                <LinearLayout
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="bottom"
                        android:paddingBottom="8dp"
                        android:paddingStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tasks"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_900" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/theme_border" />

                    <!-- CONTAINER CHO TÊN TASK -->
                    <LinearLayout
                        android:id="@+id/containerTaskLabels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Divider Right Border -->
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/theme_border" />

                <!-- CỘT PHẢI: GANTT CUỘN NGANG -->
                <HorizontalScrollView
                    android:id="@+id/ganttScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="horizontal"
                    android:fillViewport="true">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@color/theme_background">

                        <!-- Background vertical lines layer -->
                        <LinearLayout
                            android:id="@+id/containerGanttGrid"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal" />

                        <!-- Today Vertical Line Indicator -->
                        <View
                            android:id="@+id/viewTodayLine"
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:background="@color/primary"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Lớp Header Động (Tháng + Ngày) -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="56dp"
                                android:orientation="vertical">

                                <!-- Rows of Months -->
                                <LinearLayout
                                    android:id="@+id/containerGanttMonths"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:gravity="bottom"
                                    android:orientation="horizontal" />

                                <!-- Rows of Days -->
                                <LinearLayout
                                    android:id="@+id/containerGanttDays"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="bottom"
                                    android:paddingBottom="4dp"
                                    android:orientation="horizontal" />

                            </LinearLayout>

                            <!-- Bottom border for header -->
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/theme_border" />

                            <!-- LỚP CÁC THANH BAR TỪ DATABASE -->
                            <LinearLayout
                                android:id="@+id/containerGanttBars"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="8dp"
                                android:orientation="vertical" />
                        </LinearLayout>

                    </FrameLayout>
                </HorizontalScrollView>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddAI"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Tạo Task bằng AI"
            app:backgroundTint="@color/primary"
            app:tint="@color/white"
            app:srcCompat="@drawable/ic_add"
            app:elevation="6dp" />

    </FrameLayout>

    <!-- BOTTOM BAR - Giữ nguyên của bạn -->
    <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="68dp" android:paddingHorizontal="20dp" android:gravity="center_vertical" android:background="@color/theme_surface" android:elevation="8dp">
        <!-- ... (Phần Avatar) ... -->
    </LinearLayout>

</LinearLayout>