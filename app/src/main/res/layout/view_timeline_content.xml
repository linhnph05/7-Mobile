<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/layoutTimelineContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- CỘT TRÁI: Task Labels -->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="bottom"
                android:paddingBottom="8dp"
                android:paddingStart="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_list_title"
                    android:textSize="@dimen/text_xs"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_primary" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/theme_border" />

            <LinearLayout
                android:id="@+id/containerTaskLabels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/theme_border" />

        <!-- CỘT PHẢI: GANTT CHART -->
        <HorizontalScrollView
            android:id="@+id/ganttScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="horizontal"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:id="@+id/containerGanttGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />

                <com.team7.taskflow.ui.project.TimelinePastOverlayView
                    android:id="@+id/viewPastOverlay"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Today Vertical Line Indicator -->
                <View
                    android:id="@+id/viewTodayLine"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/primary"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/containerGanttMonths"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="bottom"
                            android:orientation="horizontal" />
                        <LinearLayout
                            android:id="@+id/containerGanttDays"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:paddingBottom="4dp"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/theme_border" />

                    <LinearLayout
                        android:id="@+id/containerGanttBars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </FrameLayout>
        </HorizontalScrollView>
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutEmptyStateTimeline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/avatar_lg"
            android:layout_height="@dimen/avatar_lg"
            android:layout_marginBottom="@dimen/spacing_md"
            android:src="@drawable/ic_summary"
            app:tint="@color/theme_text_hint" />

        <TextView
            android:id="@+id/tvTimelineEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overview_no_tasks"
            android:textColor="@color/theme_text_primary"
            android:textSize="@dimen/text_md"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTimelineEmptyDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:text="@string/overview_no_tasks_desc"
            android:textColor="@color/theme_text_secondary"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

</FrameLayout>
