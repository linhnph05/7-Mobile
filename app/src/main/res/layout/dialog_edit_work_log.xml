<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvWorklogDialogSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0m đã tốn • 0m còn lại"
            android:textColor="@color/theme_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Thời gian đã tốn"
            android:textColor="@color/theme_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etWorklogTimeSpent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="2h 30m"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="#94A3B8"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Thời gian còn lại"
            android:textColor="@color/theme_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etWorklogTimeRemaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="2h"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="#94A3B8"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ngày bắt đầu"
            android:textColor="@color/theme_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWorklogDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="2026-04-11"
                android:textColor="@color/theme_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvWorklogTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="10:00"
                android:textColor="@color/theme_text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mô tả công việc"
            android:textColor="@color/theme_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etWorklogDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="Bạn đã làm gì?"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="#94A3B8"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Định dạng: 2w 4d 6h 45m"
            android:textColor="@color/theme_text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
