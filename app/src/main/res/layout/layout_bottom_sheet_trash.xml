<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/theme_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tvTrashTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thùng rác"
        android:textColor="@color/theme_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listTrash"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="12dp"
        android:background="@color/theme_surface"
        android:divider="@color/theme_divider"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEmptyTrash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@color/bg_red_50"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="Dọn sạch"
            android:textColor="@color/text_red_600"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnCloseTrash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_neutral"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="Đóng"
            android:textColor="@color/theme_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
