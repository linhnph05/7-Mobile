<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"> <!-- Grey background like Dashboard -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- UNIFIED HEADER (Top Bar + Navigation Tabs) -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:elevation="4dp">

            <!-- TOP APP BAR -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingHorizontal="16dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="?attr/colorOnSurface"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintEnd_toStartOf="@id/layoutRightIcons"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/tvProjectName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Project Name"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="?attr/android:textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutRightIcons"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageButton
                        android:id="@+id/btnProjectActivity"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Project activity"
                        android:src="@drawable/ic_history"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btnMoreOptions"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Options"
                        android:src="@drawable/ic_more_vert"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- NAVIGATION TABS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <!-- Overview -->
                <LinearLayout
                    android:id="@+id/tabOverview"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/ivTabOverview"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_summary"
                        app:tint="?attr/android:textColorSecondary" />
                    <TextView
                        android:id="@+id/tvTabOverview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng quan"
                        android:textColor="?attr/android:textColorSecondary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- Board -->
                <LinearLayout
                    android:id="@+id/tabBoard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/ivTabBoard"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_board"
                        app:tint="?attr/android:textColorSecondary" />
                    <TextView
                        android:id="@+id/tvTabBoard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bảng"
                        android:textColor="?attr/android:textColorSecondary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- Task List -->
                <LinearLayout
                    android:id="@+id/tabList"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/ivTabList"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_nav_tasks"
                        app:tint="?attr/android:textColorSecondary" />
                    <TextView
                        android:id="@+id/tvTabList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Danh sách"
                        android:textColor="?attr/android:textColorSecondary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- Timeline -->
                <LinearLayout
                    android:id="@+id/tabTimeline"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/ivTabTimeline"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_timeline"
                        app:tint="?attr/android:textColorSecondary" />
                    <TextView
                        android:id="@+id/tvTabTimeline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiến độ"
                        android:textColor="?attr/android:textColorSecondary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>

                <!-- Calendar -->
                <LinearLayout
                    android:id="@+id/tabCalendar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/ivTabCalendar"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="?attr/android:textColorSecondary" />
                    <TextView
                        android:id="@+id/tvTabCalendar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lịch"
                        android:textColor="?attr/android:textColorSecondary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- CONTENT CONTAINER -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Nút tạo task mới: đặt bên phải, chiều cao được tinh chỉnh bằng positionCreateTaskButton() -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddAI"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/spacing_lg"
                android:contentDescription="@string/task_create_title"
                app:backgroundTint="@color/primary"
                app:tint="@color/white"
                app:srcCompat="@drawable/ic_add"
                app:elevation="10dp"
                app:pressedTranslationZ="14dp"
                app:borderWidth="0dp" />
        </FrameLayout>
    </LinearLayout>

    <include
        android:id="@+id/includeBottomBar"
        layout="@layout/layout_bottom_nav_fab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
