<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/theme_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task Actions"
        android:textColor="@color/theme_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnActionHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chip_neutral"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:text="Activity History"
        android:textColor="@color/theme_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnActionTrash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_neutral"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:text="Move to Trash"
        android:textColor="@color/text_red_600"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnActionCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_neutral"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:text="Cancel"
        android:textColor="@color/theme_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
