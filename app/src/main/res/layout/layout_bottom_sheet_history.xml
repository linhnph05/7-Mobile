<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/theme_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tvHistoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activity History"
        android:textColor="@color/theme_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listHistory"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="12dp"
        android:background="@color/theme_surface"
        android:divider="@color/theme_divider"
        android:dividerHeight="1dp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/btnCloseHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_neutral"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="Đóng"
        android:textColor="@color/slate_600"
        android:textSize="14sp" />

</LinearLayout>
