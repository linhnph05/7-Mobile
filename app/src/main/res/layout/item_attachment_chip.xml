<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_chip_neutral"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Icon theo loại file — set programmatically -->
    <ImageView
        android:id="@+id/ivFileIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_attach_file"
        app:tint="@color/theme_text_secondary" />

    <!-- Thumbnail ảnh — chỉ hiện khi là image -->
    <ImageView
        android:id="@+id/ivImageThumb"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:background="@drawable/bg_chip_neutral" />

    <!-- CÁC NÚT THAO TÁC (Dời lên trước để tránh nút Xóa) -->
    <!-- Nút xem trước -->
    <ImageView
        android:id="@+id/btnPreview"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:padding="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_eye"
        app:tint="@color/primary" />

    <!-- Nút tải xuống -->
    <ImageView
        android:id="@+id/btnDownload"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:padding="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_download"
        app:tint="@color/success" />

    <TextView
        android:id="@+id/tvFileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:text="filename.pdf"
        android:textColor="@color/theme_text_primary"
        android:textSize="13sp" />

    <!-- Nút xóa (Giữ ở cuối - biệt lập) -->
    <ImageView
        android:id="@+id/btnRemoveFile"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@color/theme_text_hint" />

</LinearLayout>