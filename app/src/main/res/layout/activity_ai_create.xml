<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/bgOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:clickable="true"
        android:focusableInTouchMode="true"
        android:paddingTop="8dp">

        <!-- ═══ PROMPT INPUT ═══ -->
        <TextView
            android:id="@+id/tvSubTaskInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@color/theme_surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/theme_text_primary"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/etPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:background="@null"
            android:hint="@string/ai_create_prompt_hint"
            android:inputType="textMultiLine"
            android:minHeight="100dp"
            android:gravity="top|start"
            android:textColor="@color/theme_text_primary"
            android:textColorHint="@color/theme_text_hint"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/tvSubTaskInfo"
            app:layout_constraintBottom_toTopOf="@id/divider1" />

        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/theme_divider"
            app:layout_constraintBottom_toTopOf="@id/sectionFields" />

        <!-- ═══ TASK FIELDS SECTION ═══ -->
        <LinearLayout
            android:id="@+id/sectionFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Task Title -->
            <EditText
                android:id="@+id/etParsedTitle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_field_outline"
                android:hint="@string/ai_create_title_hint"
                android:inputType="text"
                android:singleLine="true"
                android:paddingHorizontal="12dp"
                android:textColor="@color/theme_text_primary"
                android:textColorHint="@color/theme_text_hint"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Task Description -->
            <EditText
                android:id="@+id/etParsedDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field_outline"
                android:hint="@string/ai_create_desc_hint"
                android:inputType="textMultiLine"
                android:minHeight="60dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:gravity="top|start"
                android:textColor="@color/theme_text_primary"
                android:textColorHint="@color/theme_text_hint"
                android:textSize="14sp" />

            <!-- ═══ ROW 1: Start Date, Due Date ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Start Date Panel -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_start_date_label"
                        android:textColor="@color/theme_text_hint"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"
                        android:layout_marginStart="2dp" />

                    <LinearLayout
                        android:id="@+id/cardStartDate"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip_neutral"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivParsedStartDate"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_calendar_today"
                            app:tint="@color/theme_text_secondary" />
                        <TextView
                            android:id="@+id/tvParsedStartDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/task_date_placeholder"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Due Date Panel -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_task_due_date_label"
                        android:textColor="@color/theme_text_hint"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"
                        android:layout_marginStart="2dp" />

                    <LinearLayout
                        android:id="@+id/cardDueDate"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_chip_neutral"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivParsedDueDate"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_calendar_today"
                            app:tint="@color/theme_text_secondary" />
                        <TextView
                            android:id="@+id/tvParsedDueDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/task_date_placeholder"
                            android:textColor="@color/theme_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ═══ ROW 2: Priority, Assignee ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Priority -->
                <LinearLayout
                    android:id="@+id/cardPriority"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_neutral"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivParsedPriority"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_flag"
                        app:tint="@color/theme_text_secondary" />
                    <TextView
                        android:id="@+id/tvParsedPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_priority_label"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Assignee -->
                <LinearLayout
                    android:id="@+id/cardAssignee"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_neutral"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivParsedAssignee"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/theme_text_secondary" />
                    <TextView
                        android:id="@+id/tvParsedAssignee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_assignee_label"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ═══ ROW 3: Tag, File Attachment ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Tag -->
                <LinearLayout
                    android:id="@+id/cardTag"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_neutral"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivParsedTag"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_label"
                        app:tint="@color/theme_text_secondary" />
                    <TextView
                        android:id="@+id/tvParsedTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_tag_label"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- File Attachment -->
                <LinearLayout
                    android:id="@+id/cardAttachment"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_neutral"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivAttachment"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_attach_file"
                        app:tint="@color/theme_text_secondary" />
                    <TextView
                        android:id="@+id/tvAttachment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_attach_label"
                        android:textColor="@color/theme_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Attached files container (empty by default) -->
            <LinearLayout
                android:id="@+id/containerAttachments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- ═══ BOTTOM BAR: Task ID (left) + Save button (right) ═══ -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <!-- Task ID badge -->
                <TextView
                    android:id="@+id/tvTaskId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_task_id"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/ai_create_badge"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Send / Save button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    app:cardBackgroundColor="@color/primary"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">
                    <ImageButton
                        android:id="@+id/btnSaveTask"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="@color/white" />
                </androidx.cardview.widget.CardView>

            </RelativeLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
