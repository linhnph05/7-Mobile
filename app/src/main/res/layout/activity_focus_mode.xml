<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvFocusState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/focus_mode_state_deep"
        android:textColor="@color/primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_pill_neutral"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvFocusTaskTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Tên công việc"
        android:textColor="@color/theme_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvFocusState"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/layoutCircle"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_focus_circle_surface"
        android:elevation="6dp"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvFocusTaskTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressFocusTimer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:indicatorSize="260dp"
            app:trackThickness="14dp"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/theme_divider"
            android:indeterminate="false" />

        <TextView
            android:id="@+id/tvFocusTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="25:00"
            android:textColor="@color/theme_text_primary"
            android:textSize="52sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvFocusTaskDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/theme_text_secondary"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/layoutCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Prepare architecture diagram and clean up edge cases before review." />

    <TextView
        android:id="@+id/tvFocusHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/focus_mode_hint"
        android:textColor="@color/theme_text_primary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvFocusTaskDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btnStopFocus"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_focus_stop_button"
        android:gravity="center"
        android:text="@string/focus_mode_stop_button"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
