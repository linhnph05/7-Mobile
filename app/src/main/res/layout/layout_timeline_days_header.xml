<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Day 1 -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/timeline_weekday_mon" android:textSize="10sp" android:textColor="@color/theme_text_secondary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/theme_text_primary" />
        </LinearLayout>
        <!-- Vertical Grid Line -->
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/colorOutlineVariant" android:alpha="0.3" android:layout_gravity="end" />
    </FrameLayout>

